# ==============================================================================
# IIPS Smart Classroom Attendance Management System - Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME=IIPS Smart Classroom Attendance Management System
APP_ENV=development
SECRET_KEY=change-this-secret-key-to-a-strong-random-value-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Low Attendance Warning Threshold (in percentage)
LOW_ATTENDANCE_THRESHOLD=70.0

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (For QR Links & Redirects)
FRONTEND_URL=http://localhost:5173

# Database Configuration (SQLite default for local development, or MySQL for production)
# SQLite: sqlite:///./iips_attendance.db
# MySQL:  mysql+pymysql://root:password@localhost:3306/iips_attendance
DATABASE_URL=sqlite:///./iips_attendance.db

# Optional MySQL specific settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=iips_attendance
DB_USER=root
DB_PASSWORD=your_mysql_password
