# App configuration
APP_NAME=IIPS Smart Classroom Attendance Management System
APP_ENV=development
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to the frontend URL students can reach (for phone testing, use this PC's LAN IP).
FRONTEND_URL=http://localhost:5173

# Local development database. The backend creates this file on startup.
DATABASE_URL=sqlite:///./iips_attendance.db

# Optional MySQL configuration. Set DATABASE_URL to a MySQL SQLAlchemy URL to use it.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=iips_attendance
DB_USER=root
DB_PASSWORD=your_mysql_password
